# Supabase > Connect > Session pooler connection string (works on free hosts)
DATABASE_URL="postgresql://postgres.YOURREF:YOURPASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"
JWT_SECRET="paste-a-random-string-of-at-least-32-characters"
FRONTEND_ORIGIN="http://localhost:5173"
PORT=4000
# Optional: password given to the sample accounts when seeding
SEED_PASSWORD="Book@123"
